<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NeonDash.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    The pure game-logic sources are compiled a SECOND time here, directly from
    the Godot project's Scripts/Core folder (two levels up from this project).
    This keeps a single source of truth: the same files the game runs are the
    files the tests exercise, with no engine dependency required to run them.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../Scripts/Core/*.cs" />
  </ItemGroup>

</Project>
